{
  "appId": "com.humanbalanceai.whisper-drop",
  "productName": "whisper-drop",
  "copyright": "Copyright (c) 2026 Ben Junya",
  "directories": {
    "output": "dist"
  },
  "files": ["out/**", "package.json"],
  "asar": true,
  "asarUnpack": ["node_modules/ffmpeg-static/**", "node_modules/ffprobe-static/**"],
  "extraResources": [
    {
      "from": "resources/${platform}-${arch}",
      "to": "resources/${platform}-${arch}"
    }
  ],
  "npmRebuild": false,
  "publish": null,
  "mac": {
    "target": ["dmg"],
    "category": "public.app-category.productivity",
    "identity": null,
    "notarize": false
  },
  "win": {
    "target": ["nsis"]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "category": "AudioVideo",
    "maintainer": "Human Balance AI <noreply@humanbalanceai.com>",
    "synopsis": "Drag a media file in, get a transcript out — on your own machine."
  }
}
