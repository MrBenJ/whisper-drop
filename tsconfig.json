{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "src/main",
    "src/shared",
    "src/types",
    "test/build",
    "test/main",
    "test/shared",
    "test/integration",
    "test/e2e",
    "electron.vite.config.ts",
    "vitest.config.ts",
    "vitest.integration.config.ts",
    "vitest.e2e.config.ts"
  ]
}
